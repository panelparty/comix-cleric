# Comix Cleric Config
COMIX_CLERIC_SECRET="YOUR_SECRET_STRING" # Keeps your site safe/unique

# Database Config
DB_ADAPTER="sqlite" # (Default: sqlite) Options: sqlite, mongodb
DB_PATH="./data/comix-cleric.db"

# MongoDB Config
MONGODB_URI="mongodb+srv://<db_user>:<db_password>@<cluster_name>.<cluster_id>.mongodb.net/"
MONGODB_DATABASE="db_name"

# Storage Config
STORAGE_ADAPTER="local" # (Default: local)

# Email Config
EMAIL_ADAPTER="resend" # (Default: resend)
EMAIL_API_KEY="YOUR_API_KEY"
EMAIL_SENDER="support@example.com"